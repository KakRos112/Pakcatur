[Unit]
Description=Pakcatur - server game catur
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=__PORT__
Environment=HOST=__HOST__
Environment=TRUST_PROXY=1
ExecStart=__NODE__ __APP_DIR__/server.js
Restart=always
RestartSec=3
# Pengamanan ringan yang tetap jalan di LXC unprivileged
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
